# FreykoBot - Jet-style Polymarket crypto up/down strategy
# Start with dry-run. Live mode is intentionally double-gated.

DRY_RUN=true
FREYKO_ALLOW_LIVE=false

# Price feeds
PRICE_PRIMARY=binance
BINANCE_WS_URL=wss://data-stream.binance.vision/stream?streams=btcusdt@trade/ethusdt@trade&timeUnit=MICROSECOND
COINBASE_ENABLED=true
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
MAX_PRICE_LAG_MS=700

# Polymarket data
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
POLY_WS_ENABLED=true
POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
REST_BOOK_FALLBACK_SECONDS=2.0

# Market universe
FREYKO_FAMILIES=btc5m,eth5m,btc15m
FREYKO_POLL_SECONDS=0.25
FREYKO_MAX_LOOPS=0
FREYKO_LOG_DIR=logs

# Strategy sizing/risk
FREYKO_LOT_SHARES=10
FREYKO_MIN_ORDER_NOTIONAL=5
FREYKO_MAX_MARKET_COST=160
FREYKO_MAX_SIDE_COST=110
FREYKO_MAX_TRADES_PER_MARKET=24
FREYKO_DAILY_LOSS_LIMIT=150
FREYKO_MAX_BUY_PRICE=0.92
FREYKO_COOLDOWN_SECONDS=3.0

# Momentum + lag thresholds. Momentum values are percent changes, e.g. 0.03 = 0.03%.
FREYKO_MIN_MOMENTUM_5=0.010
FREYKO_MIN_MOMENTUM_10=0.015
FREYKO_STRONG_MOMENTUM=0.040
FREYKO_MOMENTUM_TO_PROB=6.0
FREYKO_MIN_EDGE=0.035

# Two-sided inventory / hedge ladder
FREYKO_PAIR_ARB_MAX=0.99
FREYKO_HEDGE_PAIR_MAX=1.03
FREYKO_HEDGE_MAX_PRICE=0.38
FREYKO_HEDGE_TARGET_COST_RATIO=0.58
FREYKO_AVOID_PAIR_SUM_GT=1.14

# Entry windows
FREYKO_ENTRY_START_5M=285
FREYKO_ENTRY_START_15M=840
FREYKO_ENTRY_END_SECONDS=7
FREYKO_RESOLVE_DELAY_SECONDS=2
FREYKO_REQUIRE_OPEN_SEEN=true
FREYKO_OPEN_CAPTURE_GRACE_SECONDS=6

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SILENT=false
TELEGRAM_TIMEOUT=6

# Live trading credentials. Leave blank in dry-run.
PRIVATE_KEY=
SIGNATURE_TYPE=3
FUNDER_ADDRESS=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
